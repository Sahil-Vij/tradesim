{
  "name": "@tradesim/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "dev:prices": "node --watch --env-file-if-exists=../.env src/price-worker.ts",
    "prices": "node --env-file-if-exists=../.env src/price-worker.ts",
    "dev:orders": "node --watch --env-file-if-exists=../.env src/order-worker.ts",
    "orders": "node --env-file-if-exists=../.env src/order-worker.ts",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "bullmq": "^6.7.10",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "ws": "^8.23.0"
  }
}
